<% layout("./layouts/boilerplate") %>

    <script>
        const mapToken = <%- JSON.stringify(process.env.MAP_TOKEN) %>;
        const coordinates = <%- JSON.stringify(listings.geometry.coordinates) %>;
        const listing = <%- JSON.stringify(listings) %>;
    </script>
    <main class="listing-detail-page">
        <div class="listing-detail-header">
            <div>
                <p class="detail-eyebrow"><i class="fa-solid fa-location-dot"></i> Featured stay</p>
                <h1>
                    <%= listings.title %>
                </h1>
                <p class="detail-location"><i class="fa-solid fa-map-pin"></i>
                    <%= listings.location %>, <%= listings.country %>
                </p>
            </div>
            <% if(currUser && listings.owner._id.equals(currUser._id)) { %>
                <div class="btns">
                    <a href="/listings/<%=listings._id%>/edit" class="btn btn-dark edit-btn">Edit listing</a>
                    <form method="post" action="/listings/<%=listings._id%>?_method=DELETE">
                        <button class="btn btn-outline-danger delete-btn">Delete</button>
                    </form>
                </div>
                <% } %>
        </div>

        <section class="listing-detail-grid" aria-label="Listing details">
            <div class="listing-detail-media">
                <img src="<%- listings.image.url %>" class="show-img" alt="<%= listings.title %>">
            </div>
            <div class="listing-detail-summary">
                <div class="owner-line">
                    <span class="owner-avatar"><i class="fa-solid fa-user"></i></span>
                    <span>Hosted by <strong>
                            <%=listings.owner.username %>
                        </strong></span>
                </div>
                <p class="listing-description">
                    <%=listings.description %>
                </p>
                <div class="listing-facts">
                    <div><span class="fact-label">Location</span><strong>
                            <%=listings.location%>
                        </strong></div>
                    <div><span class="fact-label">Country</span><strong>
                            <%=listings.country%>
                        </strong></div>
                    <div><span class="fact-label">Price</span><strong>₹<%=listings.price%> <small>per
                                    night</small></strong></div>
                </div>
            </div>
        </section>



        <!-- Review Form-->

        <section class="listing-reviews mb-3">
            <% if(currUser) {%>
                <div class="review-form-section">
                    <h2>Leave a review</h2>
                    <form action="/listings/<%=listings.id%>/reviews" method="POST" novalidate class="needs-validation">

                        <div class="mb-3 mt-3">
                            <label for="rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">

                                <input type="radio" id="rate1" name="review[rating]" value="1">
                                <label for="rate1" title="Terrible">1 star</label>

                                <input type="radio" id="rate2" name="review[rating]" value="2">
                                <label for="rate2" title="Bad">2 stars</label>

                                <input type="radio" id="rate3" name="review[rating]" value="3">
                                <label for="rate3" title="Okay">3 stars</label>

                                <input type="radio" id="rate4" name="review[rating]" value="4">
                                <label for="rate4" title="Good">4 stars</label>

                                <input type="radio" id="rate5" name="review[rating]" value="5">
                                <label for="rate5" title="Excellent">5 stars</label>
                            </fieldset>
                        </div>


                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                required></textarea>
                            <div class="invalid-feedback">Please add some comments for review
                            </div>
                        </div>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                </div>
                <% } %>





                    <% if(listings.reviews.length> 0) { %>
                        <div class="reviews-section">
                            <h2>Guest reviews <span>(<%= listings.reviews.length %>)</span></h2>
                            <div class="reviews-grid">

                                <% for(review of listings.reviews) {%>
                                    <div class="card review-card">
                                        <div class="card-body">
                                            <h5 class="card-title">
                                                <%=review.author.username%>
                                            </h5>
                                            <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                            </p>
                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>

                                            <form class="mb-3" method="POST"
                                                action="/listings/<%= listings._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <% if(currUser && listings.owner._id.equals(currUser._id)) { %>
                                                    <button class="btn btn-dark btn-sm">Delete</button>
                                                    <% } %>


                                            </form>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                        <% } %>



        </section>
        <section class="listing-map-section mb-3">
            <h2>Where you'll be</h2>
            <div id="map"></div>
        </section>
    </main>


    <script src="/js/map.js"></script>